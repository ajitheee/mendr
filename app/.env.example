# Public base URL of this deployment (no trailing slash). GitHub sends webhooks
# and OAuth redirects here, so it must be reachable from the internet.
APP_URL=https://app.example.com
PORT=8080

# Printed once by /setup/callback after you create the App from the manifest.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The PEM, either multi-line or with literal \n sequences.
GITHUB_PRIVATE_KEY=

# 32+ random characters. Sessions are encrypted cookies keyed on this; if it is
# unset a random one is generated at boot and every restart signs everyone out.
SESSION_SECRET=

# Postgres. Unset = in-memory store (development only; runs vanish on restart).
DATABASE_URL=

# Optional. Defaults shown.
# GITHUB_APP_NAME=Mendr audit        # must be unique on GitHub
# OIDC_AUDIENCE=mendr                # the audience your workflow requests
# MAX_BODY_BYTES=2097152
# MAX_RUNS_PER_REPO=100
# UI_DIR=../site/app                 # serves the investigation workspace at /app
