{
  "name": "mendr",
  "version": "0.1.0",
  "description": "CLI that auto-fixes third-party API breaking changes: deprecated LLM model ids and coupled params (OpenAI/Anthropic/Google), plus Stripe renames. It prints a verified diff and never writes your working tree on its own.",
  "type": "module",
  "bin": {
    "mendr": "dist/cli.js"
  },
  "files": [
    "dist",
    "registries",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "validate:registry": "npm run build && node scripts/validate-registry.mjs",
    "validate:active-models": "npm run build && node scripts/validate-active-models.mjs",
    "start": "node dist/cli.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "cli",
    "codemod",
    "breaking-changes",
    "deprecation",
    "api-migration",
    "stripe",
    "openai",
    "anthropic",
    "gemini",
    "llm",
    "model-id"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajitheee/mendr.git"
  },
  "homepage": "https://github.com/ajitheee/mendr#readme",
  "bugs": {
    "url": "https://github.com/ajitheee/mendr/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.1.2",
    "stripe": "^22.4.0",
    "tree-sitter-python": "^0.25.0",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "execa": "^10.0.1",
    "simple-git": "^3.36.0",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "^0.26.12"
  }
}
